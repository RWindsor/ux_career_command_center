# Neon Serverless Postgres — copy the "Pooled connection" string from
# your Neon project dashboard (Connection Details -> Pooled connection).
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Auth.js — generate with: npx auth secret
AUTH_SECRET=your-generated-auth-secret

# Base URL of the app, used for redirects. Set to your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key

# Optional — defaults to gemini-2.5-flash if unset
GEMINI_MODEL=gemini-2.5-flash

# Vercel Cron auth — generate any random string (e.g. `openssl rand -hex 32`).
# Set the SAME value in your Vercel project's environment variables.
# Vercel automatically sends it as a Bearer token on scheduled requests
# to /api/cron/* (see vercel.json) once this is set.
CRON_SECRET=your-generated-cron-secret

# Search-driven job discovery (optional but required for saved searches
# to auto-find company boards — see lib/discovery/search-provider.ts).
# Uses the Brave Search API (a currently-supported full-web search API —
# Google's Custom Search JSON API, used here previously, is closed to
# new customers and returns 403). Get a key at
# https://api-dashboard.search.brave.com/register — the free tier is
# enough for personal-scale use. Without this set, saved searches show a
# clear "not configured" state and you can still watch specific boards
# manually from the Discovery page.
BRAVE_SEARCH_API_KEY=your-brave-search-api-key

# Optional — selects which web-search provider board resolution uses.
# Only "brave" is implemented today; this exists so a different
# provider can be swapped in later via lib/discovery/search-provider.ts
# without any code changes on your end. Defaults to "brave" if unset.
SEARCH_PROVIDER=brave

# Staged rollout of SCHEDULED discovery (Vercel cron). Imports only run when this is exactly the string: true
# Leave unset/false until every active saved search has an eligible country and a small manual batch looks right.
DISCOVERY_CRON_ENABLED=false
